  mostrarSpriteBefore: 010001
  falasAfterNightmare:
  - "E a\xED, Franz! J\xE1 arrumou um emprego ou ainda est\xE1 brincando de escrever
    hist\xF3rias!"
  - Receio que eu esteja fazendo os dois agora.
  - "Olha s\xF3! Meus parab\xE9ns!"
  - Ugh
  spritesAfterNightmare: []
  mostrarSpriteAfter: 
