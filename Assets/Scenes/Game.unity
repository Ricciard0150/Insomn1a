  - {fileID: -5800636680357492039, guid: 98837110c52949442b144520f9b71aea, type: 3}
  falasBeforeNightmare:
  - "Franz? Voc\xEA teve aquela entrevista de emprego certo? Como foi?\n"
  - "\u2026"
  - "T\xE3o ruim assim?"
  spritesBeforeNightmare:
  - {fileID: -5800636680357492039, guid: 98837110c52949442b144520f9b71aea, type: 3}
  - {fileID: 0}
