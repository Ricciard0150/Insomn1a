--- !u!114 &7403226418524137358
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 9034563132457537295}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e1ba15407711621448adcaf38e79b6b6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::PaperMinigameManager
  minigamePanel: {fileID: 4121805660760086595}
  timerText: {fileID: 8108100940027012132}
  roundText: {fileID: 3955346179239500563}
  errorText: {fileID: 2447242022131347325}
  gameOverPanel: {fileID: 2023631145}
  dialogueSystem: {fileID: 1704881960}
  fadeController: {fileID: 0}
  gameOverUI: {fileID: 732364235}
  defeatDialogueLines:
  - characterSprite: {fileID: 0}
    characterName: "Patr\xE3o"
    text: "N\xC3O PRECISO DE UM FUNCION\xC1RIO QUE N\xC3O CONSIGA FAZER AS COISAS
      NO MEU TEMPO!"
  - characterSprite: {fileID: 0}
    characterName: "Patr\xE3o"
    text: "RUA! VOC\xCA EST\xC1 DEMITIDO!"
  dialoguesBetweenRounds:
  - lines:
    - playHandAnimation: 1
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "O trabalho \xE9 muito simples: \xE9 s\xF3 pegar esses panfletos e
          colocar nas pilhas corretas!"
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "N\xE3o demore muito, hein! Tem mais pessoas querendo a sua vaga, se
          \xE9 que me entende..."
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: Hm... okay?
  - lines:
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: "O trabalho \xE9 isso? pensei que tivesse mais coisas para faz-"
    - playHandAnimation: 1
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "Ol\xE1, Franz! Mais trabalho para voc\xEA hehe..."
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: Sem problemas... eu acho...
  - lines:
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: Tempo para um descanso, talvez...
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: Acho que vou pegar algo para come-
    - playHandAnimation: 1
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "Ol, meu funcion\xE1rio favorito!"
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: Ah...
  - lines:
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: "N\xE3o \xE9 poss\xEDvel que tenha algo para fazer..."
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: "Olha s\xF3, acho que tenho um tempo!"
    - playHandAnimation: 1
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "Fa\xE7a seu trabalho!"
  - lines:
    - playHandAnimation: 1
      lineData:
        characterSprite: {fileID: 0}
        characterName: "Patr\xE3o"
        text: "S\xF3 mais esse, eu juro!"
    - playHandAnimation: 0
      lineData:
        characterSprite: {fileID: 0}
        characterName: Kafka
        text: Okay...
  finalVictoryLines:
  - characterSprite: {fileID: 0}
    characterName: "Patr\xE3o"
    text: "Okay, Kafka, est\xE1 dispensado!"
  - characterSprite: {fileID: 0}
    characterName: Kafka
    text: Ugh, obr-iga-do..
  postMinigameLines:
  - characterSprite: {fileID: 0}
    characterName: "Patr\xE3o"
    text: "Voc\xEA est\xE1 bem, Kafka?"
  - characterSprite: {fileID: 0}
    characterName: Kafka
    text: SIm, eS-toU... prEcisO iR para CAsA
  - characterSprite: {fileID: 0}
    characterName: "Patr\xE3o"
    text: "Okay... sua casa \xE9 abaixo \xE0 direita viu? Acho que voc\xEA nem deve
      se lembrar..."
  allSpots:
  - {fileID: 2734268101585135920}
  - {fileID: 8711809240504566253}
  - {fileID: 4685079766791589475}
  paperPrefab: {fileID: 9210045579418939001, guid: 2988cbc2ef7259e4db01fd115320d8f8, type: 3}
  spawnPoint: {fileID: 339267359490058376}
  placeholderNaCena: {fileID: 1286618145}
