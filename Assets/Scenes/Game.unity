--- !u!114 &749839218
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 749839217}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e7f4de7e9aa35b544b1b49f98cf3057f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestDatabase
  quests:
  - questId: interview
    questName: Inicial interview
    npcName: Interviewer
    introDialogue:
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: "Ol\xE1, Senhor, eu tinha aplicado meu curr\xEDculo aqui semana passada\u2026"
    - characterSprite: {fileID: 0}
      characterName: Chefe
      text: "Ol\xE1, sr. Franz. Bom, a princ\xEDpio o senhor est\xE1 aprovado mas
        antes preciso fazer algumas perguntas para checar se voc\xEA \xE9 realmente
        qualificado\r\n"
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: "Certo\u2026"
    victoryDialogue:
    - characterSprite: {fileID: 0}
      characterName: Chefe
      text: "Muito bem, sr Fraz, est\xE1 contratado."
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: Muito obrigado senhor!
    - characterSprite: {fileID: 0}
      characterName: Chefe
      text: "Voc\xEA vai encontrar o gerente no \xFAltimo pr\xE9dio da firma na rua
        \xE0 esquerda. Ele estar\xE1 te esperando amanh\xE3."
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: Okay, obrigado senhor!
    defeatDialogue:
    - characterSprite: {fileID: 0}
      characterName: Chefe
      text: Bem... devido a seu desempenho, estaremos vendo outros candidatos para
        a vaga...
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: Okay. Obrigado, senhor...
    questions:
    - question: "Primeiramente, dando uma olhada aqui no seu curr\xEDculo percebi
        que voc\xEA disse que sabe ingl\xEAs, certo? \u2606 Gostaria que voc\xEA
        me falasse uma pequena frase como uma prova \u2606 "
      options:
      - 'Hi... I... uh...ready? '
      - 'Hi sir, im ready to work in this company. '
      - "Hola se\xF1or, estoy listo para empezar a trabajar en esta empresa. "
      - "I... N\xC3O SEI"
      correctAnswer: 1
      correctFeedback: "Ele n\xE3o parece satisfeito..."
      wrongFeedback: "Voc\xEA o satisfez..."
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: 4584681769223179126, guid: ad5875058d613a643acda07d7b95a6f9, type: 3}
          characterName: Chefe
          text: "Tsc... tenha mais certeza do que voc\xEA p\xF5e no curr\xEDculo..."
        - characterSprite: {fileID: -5144542264298086051, guid: c7707fa669e833140844da9b6fa94a72, type: 3}
          characterName: Kafka
          text: ...
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Hm, interessante
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: "Bem falado, mas receio que isso n\xE3o seja ingl\xEAs..."
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Que falta de classe...
    - question: "Ok, aqui voc\xEA tamb\xE9m diz ser r\xE1pido em c\xE1lculos  matem\xE1ticos
        \u2606 Vou te dar uma pequena equa\xE7\xE3o e quero que me responda: 246+34. "
      options:
      - 280.
      - 290
      - 300
      - '302. '
      correctAnswer: 3
      correctFeedback: Ele parece feliz
      wrongFeedback: "Voc\xEA irritou ele, n\xE3o era t\xE3o dif\xEDcil!"
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: "Bom para o n\xEDvel de uma crian\xE7a na creche..."
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Bem longe...
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Se fosse com um pouco mais de calma...
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Correto, muito bom!
        - characterSprite: {fileID: 0}
          characterName: Kafka
          text: "Agrade\xE7o, senhor!"
    - question: "Apenas uma d\xFAvida, com qual animal voc\xEA se identifica? "
      options:
      - "Com certeza um le\xE3o, senhor."
      - Talvez uma galinha...?
      - Me identifico bastante com um rato!
      - "N\xE3o sei, sou \xFAnico demais para ser comparado."
      correctAnswer: 0
      correctFeedback: "Ele est\xE1 orgulhoso"
      wrongFeedback: Ele parece enojado...?
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: "Esse \xE9 o esp\xEDrito!"
        - characterSprite: {fileID: 0}
          characterName: Kafka
          text: (Estufa o peito com orgulho de si)
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Eh... okay...
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Rapaz?
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: "Ah, como ele \xE9 \xFAnico."
        - characterSprite: {fileID: 0}
          characterName: Kafka
          text: "Isso \xE9 um elogio?"
        - characterSprite: {fileID: 0}
          characterName: Chefe
          text: Interprete como quiser.
        - characterSprite: {fileID: 0}
          characterName: Kafka
          text: "Ent\xE3o \xE9 bom!"
    maxLives: 3
    minCorrect: 1
    objectToActivate: 
    objectToDeactivate: 
  - questId: papai
    questName: dialogopapai
    npcName: papai
    introDialogue:
    - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
      characterName: Pai
      text: Frank?
    - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
      characterName: Pai
      text: "O que voc\xEA est\xE1 fazendo em casa seu desempregado. Achei que tivesse
        deixado claro para n\xE3"
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: Sim, pai, mas-
    - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
      characterName: Pai
      text: "Da \xFAltima vez que voc\xEA disse isso n\xE3o apareceu com um tost\xE3o
        em casa!\r\n"
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: 'Mas dessa vez eu consigo provar!

'
    - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
      characterName: Pai
      text: "Ent\xE3o prove!"
    victoryDialogue:
    - characterSprite: {fileID: 0}
      characterName: 'Pai '
      text: Ugh *resmunga*
    defeatDialogue:
    - characterSprite: {fileID: 0}
      characterName: Kafka
      text: Fora dessa casa AGORA!
    questions:
    - question: "Muito bem, seu imprest\xE1vel! Voc\xEA diz que conseguiu um emprego,
        mas onde diabos est\xE1 trabalhando? "
      options:
      - Eu estou trabalhando em uma empresa de seguros, pai! Fui aceito ontem
      - 'Esqueci. '
      correctAnswer: 0
      correctFeedback: "Ele n\xE3o parece satisfeito..."
      wrongFeedback: "Voc\xEA o satisfez..."
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "Hum, que bom que voc\xEA sabe..."
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "Est\xFApido, como sempre."
    - question: "Muito bem... Mas o que exatamente voc\xEA vai fazer nessa empresa?"
      options:
      - 'Vendendo pizza? '
      - 'Vender e oferecer planos de seguros.  '
      - '         '
      - '     '
      correctAnswer: 1
      correctFeedback: Ele parece feliz
      wrongFeedback: "Voc\xEA irritou ele, n\xE3o era t\xE3o dif\xEDcil!"
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "Voc\xEA \xE9 burro por acaso?"
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: Ok...
    - question: "E quem ser\xE3o seus clientes? "
      options:
      - 'Pessoas que querem guarda costas.. '
      - "Pessoas e empresas que precisam de prote\xE7\xE3o financeira.  "
      correctAnswer: 1
      correctFeedback: "Ele est\xE1 orgulhoso"
      wrongFeedback: Ele parece enojado...?
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "Daqui a pouco vou EU me guardar num caix\xE3o de tanto desgosto
            que voc\xEA me d\xE1!"
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "Parab\xE9ns por ler o contrato, jumento!"
    - question: "Voc\xEA vai receber um sal\xE1rio ou pretende trabalhar de gra\xE7a? "
      options:
      - 'Vou trabalhar remunerado, pai. '
      - "Ah, de gra\xE7a."
      correctAnswer: 0
      correctFeedback: "Ele est\xE1 orgulhoso"
      wrongFeedback: Ele parece enojado...?
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: "O sal\xE1rio deve ser uma pechincha..."
        - characterSprite: {fileID: 0}
          characterName: Kafka
          text: Disse alguma coisa?
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: Huh
      - dialogue:
        - characterSprite: {fileID: -4383708052436167638, guid: 8407b789cefdc7b4395d6cc289bf9ff2, type: 3}
          characterName: Pai
          text: Eh... okay...
    - question: "\xDAltima pergunta, Frank! O que voc\xEA pretende fazer com seu
        primeiro sal\xE1rio? "
      options:
      - "Ajudar em casa, economizar e come\xE7ar a construir meu futuro.  "
      - "Ah, de gra\xE7a."
      correctAnswer: 0
      correctFeedback: "Ajudar em casa, economizar e come\xE7ar a construir meu futuro.  "
      wrongFeedback: 'Gastar tudo de uma vez. '
      optionDialogues:
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Pai
          text: "\xC9 bom mesmo."
      - dialogue:
        - characterSprite: {fileID: 0}
          characterName: Pai
          text: "Vai escrever est\xF3rias sobre o seu fracasso profissional tamb\xE9m?"
    maxLives: 3
    minCorrect: 1
    objectToActivate: 
    objectToDeactivate: 
